# HakiOS fragment: the khaje family -- what is true of the SoC, whatever device it is in.
CONFIG_SOC="khaje"
# The processor has eight cores, ARMv8.0 (no PAN: the kernel is built with HAKIOS_ARMV8_0=1); GICv3 at 0x0f200000 / 0x0f300000 whose
# group 1 is enabled with GICD_CTLR bits 0|1|4 (two security states); the virtual timer is GIC PPI 3 = INTID 19 (soc_vtimer=19, seen on
# the phone: virtual timer 19, physical 18). CONFIG_BOOTARGS="soc_vtimer=19" once the catalogue (docs/boot-args.md) has it.
CONFIG_CPUS=1
CONFIG_SOC_VTIMER=0x13
